    "preview": "vite preview"
  },
  "dependencies": {
    "dexie": "^4.4.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tone": "^15.1.22",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "fake-indexeddb": "^6.2.7",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.0",
    "vite": "^7.1.7",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
